# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SMARTCARE_SECRET_KEY: HMAC signing key for JWT authentication.
# Leave empty in local dev to use an ephemeral runtime key, or set a strong 32+ char secret in production.
SMARTCARE_SECRET_KEY=

# DATABASE_PATH: Optional custom path for the SQLite database file (defaults to ./data/smartcare.db).
DATABASE_PATH=

# ALLOWED_ORIGINS: Comma-separated allowed CORS origins for production deployments.
ALLOWED_ORIGINS=

# META WHATSAPP BUSINESS CLOUD API (Optional - runs in explicit simulation mode if unset)
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_API_VERSION=v21.0
META_WHATSAPP_TEMPLATE_EN=smartcare_med_reminder_en
META_WHATSAPP_TEMPLATE_TA=smartcare_med_reminder_ta
META_WHATSAPP_TEMPLATE_ML=smartcare_med_reminder_ml

# TWILIO VOICE API (Optional - runs in explicit simulation mode if unset)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VOICE_WEBHOOK_BASE_URL=
